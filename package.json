{
  "name": "@wolbarg/langchain",
  "version": "1.0.1",
  "description": "Official LangChain JS / LangGraph JS adapters for Wolbarg shared memory — BaseMemory + BaseStore.",
  "license": "MIT",
  "author": {
    "name": "Atharv Munde",
    "url": "https://github.com/Atharvmunde11"
  },
  "homepage": "https://wolbarg.com/docs/integrations/langchain",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wolbarg/langchain.git"
  },
  "bugs": {
    "url": "https://github.com/wolbarg/langchain/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run clean && npm run build && npm run test"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.3.0 || >=1.0.0",
    "@langchain/langgraph": ">=0.2.0 || >=1.0.0",
    "@langchain/langgraph-checkpoint": ">=0.2.0 || >=1.0.0",
    "wolbarg": ">=0.5.4"
  },
  "peerDependenciesMeta": {
    "@langchain/langgraph-checkpoint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@langchain/core": "^1.2.0",
    "@langchain/langgraph": "^1.0.0",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "@types/node": "^22.15.21",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wolbarg": "file:../../sdk"
  },
  "keywords": [
    "wolbarg",
    "langchain",
    "langgraph",
    "BaseMemory",
    "BaseStore",
    "agent-memory",
    "shared-memory"
  ]
}
